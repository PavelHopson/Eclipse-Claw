# ============================================
# Eclipse Claw Configuration
# Copy to .env and fill in your values
# ============================================

# --- LLM Providers ---

# Ollama (local, default provider)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# OpenAI (optional cloud fallback)
# OPENAI_API_KEY   — set your OpenAI key
# OPENAI_BASE_URL  — defaults to https://api.openai.com/v1
# OPENAI_MODEL     — defaults to gpt-4o-mini

# Anthropic (optional cloud fallback)
# ANTHROPIC_API_KEY — set your Anthropic key
# ANTHROPIC_MODEL  — defaults to claude-sonnet-4-20250514

# --- Proxy ---

# --- Eclipse Cloud (optional) ---
# Key enables explicit cloud tools such as search/research.
# ECLIPSE_CLAW_API_KEY=wc_your_key
# Automatic local -> cloud transfer stays OFF unless this separate consent flag is enabled.
# ECLIPSE_CLAW_CLOUD_FALLBACK=1

# Single proxy
# ECLIPSE_CLAW_PROXY=http://user:pass@host:port

# Proxy file (one per line: host:port:user:pass)
# ECLIPSE_CLAW_PROXY_FILE=/path/to/proxies.txt

# --- Server (eclipse-claw-server only) ---
# Generate three different random values; never reuse provider or server credentials.
ECLIPSE_SERVER_TOKEN=replace-with-random-32-plus-character-token
ECLIPSE_LLM_WORKER_TOKEN=replace-with-a-different-random-32-plus-token
ECLIPSE_CDP_WORKER_TOKEN=replace-with-a-third-random-32-plus-token
# ECLIPSE_SERVER_PORT=3000
# ECLIPSE_MAX_CONCURRENCY=32
# ECLIPSE_BODY_LIMIT=4194304

# Production REST/MCP must use a separate LLM worker process/container.
# ECLIPSE_REQUIRE_ISOLATED_WORKERS=1
# ECLIPSE_LLM_WORKER_URL=http://llm-worker:3100

# Browser mode stays off unless the isolated cdp-worker profile is running.
# ECLIPSE_ENABLE_CDP=0
# ECLIPSE_CDP_WORKER_URL=http://cdp-worker:3100

# --- Durable audit ---
# Stores fixed operation/status/timing fields only: never URL, body, IP, headers or secrets.
# ECLIPSE_AUDIT_DIR=/var/lib/eclipse-claw/audit
# ECLIPSE_AUDIT_REQUIRED=1
# ECLIPSE_AUDIT_RETENTION_DAYS=14
# ECLIPSE_AUDIT_MAX_FILE_BYTES=10485760
# Read API is separately opt-in and remains Bearer-protected.
# ECLIPSE_AUDIT_READ_ENABLED=0

# Compose requires an immutable Ollama image reference.
# OLLAMA_IMAGE=ollama/ollama@sha256:replace-with-reviewed-digest

# --- CLI LLM overrides ---
# ECLIPSE_CLAW_LLM_PROVIDER=ollama
# ECLIPSE_CLAW_LLM_MODEL=qwen3:8b
# ECLIPSE_CLAW_LLM_BASE_URL=http://localhost:11434

# --- Logging ---
# ECLIPSE_CLAW_LOG=info
